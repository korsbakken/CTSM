    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Debug create_newcase with specific args",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cime/scripts/create_newcase",
            "cwd": "/cluster/work/users/${env:USER}/noresm/cases",
            "console": "integratedTerminal",
            "args": [
                "--case", "test_NorwayRect_simple_case",
                "--compset", "1850_DATM%CPLHIST_CLM50%BGC_SICE_SOCN_MOSART_CISM2%NOEVOLVE_SWAV",
                "--res", "a%NorwayRect_0.125x0.125_l%NorwayRect0.125x0.125_r%r05_g%gland4_oi%null_w%null_z%null_m%NorwayRect_0.125x0.125",
                "--machine", "betzy",
                "--project", "nn9188k",
                "--run-unsupported",
                "--walltime", "0:30:00"
            ]
        },
        {
            "name" : "Debug surfdata_land_frac_to_mesh_mask.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--mesh-file", "${workspaceFolder}/tempdata/share/meshes/ESMFmesh_NorwayRect_0.125x0.125_nomask_c251031.nc",
                "--surfdata-file", "${workspaceFolder}/tempdata/lnd/clm2/surfdata_esmf/surfdata_NorwayRect_0.125x0.125_hist_1850_78pfts_c251102.nc",
                "--output-mesh-file", "${workspaceFolder}/tempdata/share/meshes/ESMFmesh_NorwayRect_0.125x0.125_lndmask_c251031.nc" //,
                // "--surfdata-landfrac-vars", "LANDFRAC_PFT", "LANDFRAC_MKSURFDATA",
                // "--add-element-areas", "False",
                // "--log-level", "DEBUG"
            ]
        },
        {
            "name": "Debug create_newcase",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cime/scripts/create_newcase",
            "console": "integratedTerminal",
            "cwd": "/cluster/work/users/janko/noresm/cases",
            "args": [
                "--case", "test_NorwayRect_simple_case",
                "--compset", "1850_DATM%CPLHIST_CLM50%BGC_SICE_SOCN_MOSART_CISM2%NOEVOLVE_SWAV",
                "--res", "a%NorwayRect_0.125x0.125_l%NorwayRect_0.125x0.125_r%r05_g%gland4_oi%null_w%null_z%null_m%NorwayRect_0.125x0.125",
                "--machine", "betzy",
                "--project", "nn9188k",
                "--run-unsupported",
                "--walltime", "0:30:00",
                "--verbose"
            ]
        }
    ]
}